{
  "name": "media-ark",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "release:verify": "python3 tools/media-ark/verify_release.py",
    "help": "python3 src/media_ark/process_captures.py --help",
    "media-ark:dry-run": "python3 src/media_ark/process_captures.py data/captures/raw --out .media-ark --dry-run",
    "media-ark:run": "./tools/media-ark/run_media_ark.sh data/captures/raw .media-ark",
    "media-ark:watch": "./tools/media-ark/media_ark_watch.sh data/captures/raw .media-ark --watch",
    "media-ark:pipeline": "./tools/media-ark/media_ark_pipeline.sh data/captures/raw .media-ark",
    "platform:start": "./tools/media-ark/start_media_ark.sh",
    "platform:api": "python3 -m src.platform.api_server",
    "platform:mcp": "python3 -m src.platform.mcp_server",
    "platform:help": "python3 -m src.platform.api_server --help"
  },
  "license": "MIT"
}
